{
    "name":  "@glrmask/node",
    "version":  "1.0.0",
    "description":  "Native grammar-constrained decoding for Node.js and TypeScript",
    "license":  "MIT OR Apache-2.0",
    "type":  "commonjs",
    "main":  "index.cjs",
    "module":  "index.mjs",
    "types":  "index.d.ts",
    "exports":  {
                    ".":  {
                               "import":  {
                                             "types":  "./index.d.mts",
                                             "default":  "./index.mjs"
                                         },
                               "require":  {
                                              "types":  "./index.d.cts",
                                              "default":  "./index.cjs"
                                          }
                          },
                    "./package.json":  "./package.json"
                },
    "engines":  {
                    "node":  ">=22"
                },
    "optionalDependencies":  {
                                 "@glrmask/node-win32-x64-msvc":  "1.0.0",
                                 "@glrmask/node-win32-arm64-msvc":  "1.0.0",
                                 "@glrmask/node-darwin-x64":  "1.0.0",
                                 "@glrmask/node-darwin-arm64":  "1.0.0",
                                 "@glrmask/node-linux-x64-gnu":  "1.0.0",
                                 "@glrmask/node-linux-arm64-gnu":  "1.0.0",
                                 "@glrmask/node-linux-x64-musl":  "1.0.0",
                                 "@glrmask/node-linux-arm64-musl":  "1.0.0"
                             },
    "files":  [
                  "index.cjs",
                  "index.mjs",
                  "index.d.ts",
                  "index.d.mts",
                  "index.d.cts",
                  "loader.cjs",
                  "platform.cjs",
                  "platform-manifest.json",
                  "README.md",
                  "LICENSE-MIT",
                  "LICENSE-APACHE",
                  "scripts",
                  "examples",
                  "NOTICE-LARK"
              ],
    "scripts":  {
                    "build":  "node scripts/build.cjs",
                    "build:dev":  "node scripts/build.cjs --profile bindings-dev",
                    "stage:platforms":  "node scripts/stage-platforms.cjs",
                    "test":  "node --expose-gc --test tests/native.test.cjs tests/module-expr.test.cjs tests/platform-packages.test.cjs",
                    "typecheck":  "tsc -p tests/tsconfig.json",
                    "check":  "npm test && npm run typecheck",
                    "prepack":  "node scripts/check-package.cjs",
                    "test:installed":  "node scripts/test-installed.cjs"
                },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/IsaacBreen/glrmask.git",
                       "directory":  "bindings/node"
                   },
    "homepage":  "https://glrmask.com/api/javascript/",
    "bugs":  {
                 "url":  "https://github.com/IsaacBreen/glrmask/issues"
             },
    "devDependencies":  {
                            "@types/node":  "^22.0.0",
                            "typescript":  "^5.9.3"
                        }
}
