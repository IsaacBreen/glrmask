{
  "schema": "glrmask-tail-chart-v1",
  "width": 480,
  "height": 330,
  "grid": {
    "left": 64,
    "right": 18,
    "top": 24,
    "bottom": 64
  },
  "exceedance": {
    "min": 0.001,
    "max": 100,
    "inverse": true,
    "log_base": 10
  },
  "latency_us": {
    "min": 0.5,
    "max": 20000,
    "log_base": 10
  },
  "line_width": 2.4,
  "smoothing": false,
  "interpolation": {
    "json": "linear",
    "javascript": "adaptive-monotone"
  },
  "palette": {
    "light": {
      "text": "#505b6b",
      "rule": "#d5d8dd",
      "static": "#cc243b",
      "dynamic": "#9b5d8f",
      "llguidance": "#2f6f89"
    },
    "dark": {
      "text": "#c4cdc4",
      "rule": "#3d4a44",
      "static": "#d6a06f",
      "dynamic": "#9b5d8f",
      "llguidance": "#7f9090"
    }
  },
  "font_family": "Inter, ui-sans-serif, system-ui, sans-serif",
  "font_size": 13,
  "source": "Website log-axis geometry and no-grid presentation. JSON uses straight segments. JavaScript shares the adaptive monotone derivative/anchor policy, preserving endpoints and extrema with at most 2% latency error at supplied quantiles; no extrapolation.",
  "display_modes": [
    "static",
    "llguidance"
  ],
  "dynamic_preview": {
    "display_modes": [
      "static",
      "dynamic",
      "llguidance"
    ],
    "static_opacity": 0.18
  },
  "javascript_display": {
    "screen_tolerance_px": 0.75,
    "latency_tolerance": 0.02
  }
}
